NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://pulse:pulse_dev_only@postgres:5432/pulse_status?schema=public
REDIS_URL=redis://redis:6379
POSTGRES_DB=pulse_status
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
# Cookies de sessão (HttpOnly). Em produção cross-site (Vercel + Render) use
# COOKIE_SAMESITE=none; com app/api em subdomínios do mesmo site, use lax.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_SECURE=0
# Alertas por e-mail (opcional). Sem SMTP configurado, canais EMAIL não enviam.
SMTP_URL=
SMTP_FROM=pulse-status@localhost
